# Copy to .env and fill in. Never commit .env.

# SparkStock's own database, on the same PostgreSQL 16 server as SparkyTC (create it first, see the README)
DATABASE_URL=jdbc:postgresql://<postgres-host>:5432/sparkstock
DATABASE_USERNAME=sparkstock
DATABASE_PASSWORD=

# SparkyTC's docker network (`docker network ls`), and its backend on that network
SPARKYTC_NETWORK=sparkytc_app-network
SPARKYTC_API_URL=http://backend-service:8080
# the addresses people open, for links and QR labels
SPARKYTC_PUBLIC_URL=http://<server>:3000
PUBLIC_URL=http://<server>:3100

# signs the session cookie; any long random text (openssl rand -hex 32)
SESSION_SECRET=
COOKIE_SECURE=false

# shared with SparkyTC so it can list a tester's devices; the integration API is off while empty (openssl rand -hex 32)
STOCK_INTEGRATION_TOKEN=

# daily reminders in SparkyTC's bell (Spring cron: second minute hour day month weekday, in TZ)
REMINDERS_CRON=0 0 9 * * *

STOCK_PORT=3100
# JVM options of the backend (memory cap)
STOCK_JAVA_OPTIONS=-Xmx256m -XX:+UseSerialGC
LOAN_DEFAULT_DAYS=7
LOAN_MAX_DAYS=90
WARRANTY_WARNING_DAYS=30
# your time zone: loan dates end at 23:59 here, and backups run at BACKUP_TIME here
TZ=UTC
